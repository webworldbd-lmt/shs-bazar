rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is logged in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is Super Admin
    function isSuperAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && (
          request.auth.token.email.lower() == 'banglabazaroffical@gmail.com' ||
          request.auth.token.email.lower() == 'marketkoroofficial@gmail.com'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Helper function alias for admin authorization
    function isAdmin() {
      return isSuperAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Usernames collection (for unique handle reservations)
    match /usernames/{usernameDoc} {
      allow read: if true;
      allow create: if isSignedIn() && (
        (request.resource.data.get('userId', '') == request.auth.uid || request.resource.data.get('uid', '') == request.auth.uid) ||
        isSuperAdmin()
      ) && !exists(/databases/$(database)/documents/usernames/$(usernameDoc));
      allow update: if isSignedIn() && (
        (resource.data.get('userId', '') == request.auth.uid || resource.data.get('uid', '') == request.auth.uid) ||
        isSuperAdmin()
      );
      allow delete: if isSignedIn() && (
        (resource.data.get('userId', '') == request.auth.uid || resource.data.get('uid', '') == request.auth.uid) ||
        isSuperAdmin()
      );
    }

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Coupons & Settings & Banners
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
